# EPL CAS ETL 2026 - Variables de Entorno
# Copia este archivo como .env y llena los valores

# Base de datos PostgreSQL (Railway)
DATABASE_URL=postgresql://usuario:password@host:puerto/nombre_db

# Clave secreta para sesiones de Flask
SECRET_KEY=tu-clave-secreta-aqui

# Password del panel de administracion
ADMIN_PASSWORD=tu-password-admin-aqui

# Token de API de Zenput
ZENPUT_TOKEN=tu-token-zenput-aqui

# Puerto (Railway lo asigna automaticamente)
PORT=5000
